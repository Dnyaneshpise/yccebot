# --- Secrets: never commit these ---
.env
.env.*
!.env.example

# Session data grants Builder Center access. Ignore the folder contents but
# keep the folder itself in git. (Use auth/* - a bare "auth/" would make the
# "!auth/.gitkeep" negation below impossible.)
auth/*
!auth/.gitkeep
storage_state.json
*.storage_state.json
cookies.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs / temp ---
*.log
*.tmp
reports/

# NOTE: data/progress.json IS intentionally committed - the workflow updates
# and commits it so badge history survives between scheduled runs.
# --- Ad-hoc secret scratch files (created manually during setup) ---
secret.txt
aws-secret-output.txt
*secret*.txt
*-secret-output.txt
auth/*.json
# --- local probe/scratch output ---
_body.txt
_profile.txt
_*.py

# per-user approval decisions - not worth committing
data/approvals.json

# generated by scripts/install_scheduler.py
scripts/run_daily.ps1
